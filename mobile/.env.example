# HTTPS API (wymagane w trybie live na urządzeniu)
EXPO_PUBLIC_FLIP_API_URL=https://api.example.invalid

# legacy | universal — źródło radaru
EXPO_PUBLIC_FLIP_RADAR_SOURCE=legacy

# demo | live — wymuszenie trybu (domyślnie: demo bez HTTPS / web bez FLIP_WEB_LIVE)
# EXPO_PUBLIC_FLIP_APP_MODE=demo

# Zezwól na http:// w dev (tylko lokalne testy)
# EXPO_PUBLIC_FLIP_ALLOW_HTTP=1

# Włącz live API w przeglądarce (SecureStore niedostępny — sesja w pamięci procesu)
# EXPO_PUBLIC_FLIP_WEB_LIVE=1

# PostgreSQL deals API v2
# EXPO_PUBLIC_FLIP_WORKSPACE_ID=your-workspace-uuid
