import re


def cpu_ok(cpu):
    if not cpu:
        return False

    cpu = cpu.lower().strip()

    # ========================================================
    # AMD
    # Minimum: Ryzen 5 3600
    # Niepełne nazwy typu "Ryzen 5" nie przechodzą.
    # ========================================================

    match = re.search(
        r"ryzen\\s+([3579])\\s+(\\d{4})",
        cpu,
        re.I
    )

    if match:
        tier = int(match.group(1))
        model = int(match.group(2))

        if tier < 5:
            return False

        # R5 3600 lub nowsza/mocniejsza numeracja
        if model < 3600:
            return False

        return True

    # ========================================================
    # INTEL
    #
    # i5  -> minimum 9400
    # i7  -> dopuszczamy od 8700
    # i9  -> minimum 9 generacja
    #
    # Niepełne "Core i5", "i7" itd. nie przechodzą.
    # Sufiksy F/K/KF są dozwolone.
    # ========================================================

    match = re.search(
        r"i([3579])-(\\d{4,5})",
        cpu,
        re.I
    )

    if not match:
        return False

    tier = int(match.group(1))
    model = int(match.group(2))

    if tier < 5:
        return False

    # generacja:
    # 9400  -> 9
    # 10400 -> 10
    # 12400 -> 12
    # 14900 -> 14
    generation = (
        model // 1000
    )

    if tier == 5:
        if generation > 9:
            return True

        return (
            generation == 9
            and model >= 9400
        )

    if tier == 7:
        if generation >= 9:
            return True

        return (
            generation == 8
            and model >= 8700
        )

    if tier == 9:
        return generation >= 9

    return False


def ram_ok(ram):
    if ram is None:
        return False

    return ram >= 16


def hardware_ok(data):

    reasons = []

    if not cpu_ok(data.get("cpu")):
        reasons.append(
            f"CPU nie spełnia minimum: {data.get('cpu')}"
        )

    if not ram_ok(data.get("ram")):
        reasons.append(
            f"RAM poniżej 16 GB: {data.get('ram')}"
        )

    return len(reasons) == 0, reasons
