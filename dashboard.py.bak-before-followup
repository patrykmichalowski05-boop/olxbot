def connect(database):

    conn = sqlite3.connect(
        database
    )

    conn.row_factory = sqlite3.Row

    return conn


def rows(
    database,
    query,
    params=(),
):

    try:

        conn = connect(
            database
        )

        result = conn.execute(
            query,
            params,
        ).fetchall()

        conn.close()

        return result

    except Exception as e:

        print(
            "[DASHBOARD DB ERROR]",
            database,
            e,
        )

        return []


def one(
    database,
    query,
    params=(),
):

    result = rows(
        database,
        query,
        params,
    )

    if result:

        return result[0]

    return None


# ============================================================
# HELPERS
