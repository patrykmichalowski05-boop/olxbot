@app.route("/legacy")
def index():

    queue_rows = rows(
        FAST_DB,
        """
        SELECT
            status,
            COUNT(*) AS count

        FROM queue

        GROUP BY status
        """
    )

    queue = {
        "pending": 0,
        "processing": 0,
        "done": 0,
        "failed": 0,
    }

    for row in queue_rows:

        key = str(
            row["status"]
        ).lower()

        queue[key] = (
            row["count"]
        )


    market_row = one(
        MARKET_DB,
        """
        SELECT
            COUNT(*) AS total,

            COALESCE(
                SUM(
                    CASE
                        WHEN active = 1
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS active

        FROM market_offers
        """
    )

    market = {
        "total": 0,
        "active": 0,
    }

    if market_row:

        market = dict(
            market_row
        )


    alerts = rows(
        ALERT_DB,
        """
        SELECT *
        FROM alerts

        ORDER BY id DESC

        LIMIT 20
        """
    )


    top_alerts = rows(
        ALERT_DB,
        """
        SELECT *
        FROM alerts

        WHERE score IS NOT NULL

        ORDER BY
            score DESC,
            profit DESC

        LIMIT 10
        """
    )


    alert_count_row = one(
        ALERT_DB,
        """
        SELECT
            COUNT(*) AS count
        FROM alerts
        """
    )

    alert_count = (
        alert_count_row["count"]
        if alert_count_row
        else 0
    )


    open_flips = rows(
        FLIP_DB,
        """
        SELECT *
        FROM flips

        WHERE status = 'BOUGHT'

        ORDER BY id DESC
        """
    )


    sold = rows(
        FLIP_DB,
        """
        SELECT
            *,

            (
                sale_price
                -
                purchase_price
                -
                COALESCE(
                    extra_cost,
                    0
                )
            ) AS real_profit,

            (
                sale_price
                -
                predicted_quick_sale
            ) AS price_error

        FROM flips

        WHERE status = 'SOLD'

        ORDER BY sold_at DESC

        LIMIT 20
        """
    )


    stats = one(
        FLIP_DB,
        """
        SELECT

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'BOUGHT'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS open_count,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'SOLD'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS sold_count,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'SOLD'
                        THEN (
                            sale_price
                            -
                            purchase_price
                            -
                            COALESCE(
                                extra_cost,
                                0
                            )
                        )
                        ELSE 0
                    END
                ),
                0
            ) AS total_profit

        FROM flips
        """
    )


    open_count = 0
    sold_count = 0
    total_profit = 0

    if stats:

        open_count = (
            stats["open_count"]
            or 0
        )

        sold_count = (
            stats["sold_count"]
            or 0
        )

        total_profit = (
            stats["total_profit"]
            or 0
        )


    avg_profit = (
        total_profit
        /
        sold_count

        if sold_count
        else 0
    )


    accuracy_rows = rows(
        FLIP_DB,
        """
        SELECT
            sale_price,
            predicted_quick_sale

        FROM flips

        WHERE
            status = 'SOLD'
            AND predicted_quick_sale > 0
        """
    )

    errors = []

    for row in accuracy_rows:

        predicted = float(
            row[
                "predicted_quick_sale"
            ]
        )

        actual = float(
            row[
                "sale_price"
            ]
        )

        errors.append(
            abs(
                actual
                -
                predicted
            )
            /
            predicted
            *
            100
        )


    accuracy = None

    if errors:

        accuracy = max(
            0,
            100
            -
            (
                sum(errors)
                /
                len(errors)
            )
        )


    tracked_rows = rows(
        FLIP_DB,
        """
        SELECT alert_id
        FROM flips

        WHERE alert_id IS NOT NULL
        """
    )

    tracked_alert_ids = {
        row["alert_id"]
        for row in tracked_rows
    }


    modules = {
        name:
            system_state(
                unit
            )

        for name, unit
        in MODULES.items()
    }


    return render_template_string(
        HTML,

        queue=queue,
        market=market,

        alerts=alerts,
        top_alerts=top_alerts,

        alert_count=alert_count,

        open_flips=open_flips,
        sold=sold,

        open_count=open_count,
        sold_count=sold_count,

        total_profit=total_profit,
        avg_profit=avg_profit,

        accuracy=accuracy,

        tracked_alert_ids=
            tracked_alert_ids,

        modules=modules,

        now=datetime.now().strftime(
            "%d.%m.%Y %H:%M:%S"
        ),

        message=request.args.get(
            "message"
        ),

        error=request.args.get(
            "error"
        ),
    )


