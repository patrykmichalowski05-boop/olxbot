@app.post(
    "/sell/<int:flip_id>"
)
def sell(
    flip_id,
):

    sale_price = to_float(
        request.form.get(
            "sale_price"
        ),
        None,
    )

    extra_cost = to_float(
        request.form.get(
            "extra_cost"
        ),
        0,
    )


    if (
        sale_price is None
        or
        sale_price <= 0
    ):

        return redirect(
            url_for(
                "index",
                error=(
                    "Nieprawidłowa cena sprzedaży."
                ),
            )
        )


    flip = one(
        FLIP_DB,
        """
        SELECT *
        FROM flips

        WHERE
            id = ?
            AND status = 'BOUGHT'
        """,
        (
            flip_id,
        ),
    )


    if flip is None:

        return redirect(
            url_for(
                "index",
                error=(
                    "Nie znaleziono otwartego flipu."
                ),
            )
        )


    conn = connect(
        FLIP_DB
    )

    conn.execute("""
        UPDATE flips

        SET
            sale_price = ?,
            extra_cost = ?,
            sold_at = ?,
            status = 'SOLD'

        WHERE id = ?
    """, (

        sale_price,
        extra_cost,

        datetime.now().isoformat(
            timespec="seconds"
        ),

        flip_id,
    ))

    conn.commit()
    conn.close()


    real_profit = (
        sale_price
        -
        float(
            flip[
                "purchase_price"
            ]
        )
        -
        extra_cost
    )


    return redirect(
        url_for(
            "index",
            message=(
                "Sprzedaż zapisana. "
                f"Realny zysk: "
                f"{money(real_profit)}"
            ),
        )
    )



