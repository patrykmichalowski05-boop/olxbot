@app.post(
    "/buy/<int:alert_id>"
)
def buy(
    alert_id,
):

    purchase_price = to_float(
        request.form.get(
            "purchase_price"
        ),
        None,
    )

    extra_cost = to_float(
        request.form.get(
            "extra_cost"
        ),
        0,
    )

    if (
        purchase_price is None
        or
        purchase_price <= 0
    ):

        return redirect(
            url_for(
                "index",
                error="Nieprawidłowa cena zakupu.",
            )
        )


    alert = one(
        ALERT_DB,
        """
        SELECT *
        FROM alerts

        WHERE id = ?
        """,
        (
            alert_id,
        ),
    )


    if alert is None:

        return redirect(
            url_for(
                "index",
                error="Nie znaleziono alertu.",
            )
        )


    existing = one(
        FLIP_DB,
        """
        SELECT id
        FROM flips

        WHERE alert_id = ?
        """,
        (
            alert_id,
        ),
    )


    if existing:

        return redirect(
            url_for(
                "index",
                error="Ta oferta jest już śledzona.",
            )
        )


    conn = connect(
        FLIP_DB
    )

    conn.execute("""
        INSERT INTO flips (

            alert_id,

            title,
            url,

            predicted_score,
            predicted_quick_sale,
            predicted_profit,

            asking_price,
            purchase_price,

            extra_cost,

            bought_at,

            status
        )

        VALUES (
            ?, ?, ?, ?, ?, ?,
            ?, ?, ?, ?, 'BOUGHT'
        )
    """, (

        alert_id,

        alert["title"],
        alert["url"],

        alert["score"],
        alert["quick_sale"],
        alert["profit"],

        alert["price"],
        purchase_price,

        extra_cost,

        datetime.now().isoformat(
            timespec="seconds"
        ),
    ))

    conn.commit()
    conn.close()


    return redirect(
        url_for(
            "index",
            message=(
                "Komputer oznaczony jako KUPIONY."
            ),
        )
    )


