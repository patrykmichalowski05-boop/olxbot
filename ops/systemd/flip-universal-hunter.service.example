# Example only. Adapt paths/user; this file is not installed automatically.
[Unit]
Description=FlipRadar universal marketplace collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=flipradar
WorkingDirectory=/srv/flipradar
ExecStart=/srv/flipradar/.venv/bin/python -m universal_v2.hunter --config /etc/flipradar/hunter.json --env-file /etc/flipradar/hunter.env --network --deliver watch
Restart=on-failure
RestartSec=20
KillSignal=SIGTERM
TimeoutStopSec=120
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
