# ============================================================
# NORMALIZACJA
# ============================================================

def normalize_cpu(cpu):

    if not cpu:
        return None

    cpu = (
        cpu
        .upper()
        .strip()
        .replace("AMD ", "")
        .replace("INTEL ", "")
        .replace("CORE ", "")
    )

    cpu = re.sub(
        r"\s+",
        " ",
        cpu
    )

    return cpu


def normalize_gpu(gpu):

    if not gpu:
        return None

    gpu = (
        gpu
        .upper()
        .strip()
        .replace("NVIDIA ", "")
        .replace("GEFORCE ", "")
        .replace("RADEON ", "")
    )

    gpu = re.sub(
        r"\s+",
        " ",
        gpu
    )

    return gpu


# ============================================================
# RAM
# ============================================================

def ram_value(ram):

    if not ram:
        return 0

    if ram >= 64:
        return 300

    if ram >= 32:
        return 200

    if ram >= 16:
        return 120

    return 0


# ============================================================
# DYSKI
# ============================================================

def disk_value(disks):

    if not disks:
        return 0

    value = 0

    capacities_seen = set()

    for disk in disks:

        disk = disk.upper()

        match = re.search(
            r"(\d+)\s*(GB|TB)",
            disk
        )

        if not match:
            continue

        size = int(
            match.group(1)
        )

        unit = (
            match.group(2)
        )

        if unit == "TB":
            gb = size * 1000
        else:
            gb = size

        # normalizacja pojemności

        if 900 <= gb <= 1100:
            gb = 1000

        elif 450 <= gb <= 550:
            gb = 500

        elif 230 <= gb <= 280:
            gb = 250

        elif 1800 <= gb <= 2200:
            gb = 2000

        disk_type = (
            "HDD"
            if "HDD" in disk
            else "SSD"
        )

        key = (
            disk_type,
            gb
        )

        if key in capacities_seen:
            continue

        capacities_seen.add(
            key
        )

        if disk_type == "HDD":

            if gb >= 2000:
                value += 100

            elif gb >= 1000:
                value += 70

            elif gb >= 500:
                value += 40

        else:

            if gb >= 2000:
                value += 250

            elif gb >= 1000:
                value += 160

            elif gb >= 500:
                value += 100

            elif gb >= 250:
                value += 60

    return value


# ============================================================
# STARA WYCENA — FALLBACK
# ============================================================

def static_valuation(details):

    cpu = normalize_cpu(
        details.get("cpu")
    )

    gpu = normalize_gpu(
        details.get("gpu")
    )

    cpu_price = (
        CPU_VALUES.get(cpu)
    )

    gpu_price = (
        GPU_VALUES.get(gpu)
    )

    if cpu_price is None:

        return {
            "ok": False,
            "reason":
                f"Brak wyceny CPU: {cpu}"
        }

    if gpu_price is None:

        return {
            "ok": False,
            "reason":
                f"Brak wyceny GPU: {gpu}"
        }

    ram_price = ram_value(
        details.get("ram")
    )

    disks_price = disk_value(
        details.get(
            "disks",
            []
        )
    )

    # płyta + PSU + obudowa + chłodzenie
    other_parts = 450

    component_value = (
        cpu_price
        + gpu_price
        + ram_price
        + disks_price
        + other_parts
    )

    # wartość kompletnego PC
    raw_quick_sale = (
        component_value
        + 150
    )

    # dodatkowy bufor -10%
    quick_sale = round(
        raw_quick_sale
        * 0.90
    )

    return {
        "ok": True,

        "quick_sale":
            quick_sale,

        "raw_quick_sale":
            raw_quick_sale,

        "cpu_value":
            cpu_price,

        "gpu_value":
            gpu_price,

        "ram_value":
            ram_price,

        "disk_value":
            disks_price,

        "component_value":
            component_value
    }


# ============================================================
# GŁÓWNA WYCENA
# ============================================================

def estimate_flip(
    details,
    mode
):

    purchase_price = (
        details.get("price")
    )

    if not purchase_price:

        return {
            "ok": False,
            "reason": "Brak ceny zakupu"
        }

    cpu = (
        details.get("cpu")
    )

    gpu = (
        details.get("gpu")
    )

    if not cpu:

        return {
            "ok": False,
            "reason": "Brak CPU"
        }

    if not gpu:

        return {
            "ok": False,
            "reason": "Brak GPU"
        }

    # ========================================================
    # 1. STATIC FALLBACK
    # ========================================================

    static = static_valuation(
        details
    )

    # ========================================================
    # 2. MARKET.DB
    # ========================================================

    market = get_cpu_gpu_stats(
        cpu,
        gpu,
        max_age_hours=168
    )

    samples = market.get(
        "samples",
        0
    )

    market_quick = (
        market.get(
            "quick_sale"
        )
    )

    source = "STATIC"

    confidence = (
        "FALLBACK"
    )

    # ========================================================
    # 3. WYBÓR CENY
    # ========================================================

    if (
        samples >= 5
        and
        market_quick
    ):

        # Przy minimum 5 podobnych PC
        # rynek jest głównym źródłem.

        quick_sale = (
            market_quick
        )

        source = (
            "MARKET"
        )

        confidence = (
            market.get(
                "confidence"
            )
        )

    elif (
        samples >= 3
        and
        market_quick
        and
        static.get("ok")
    ):

        # 3-4 próbki:
        # rynek 60%
        # fallback 40%

        quick_sale = round(
            (
                market_quick
                * 0.60
            )
            +
            (
                static[
                    "quick_sale"
                ]
                * 0.40
            )
        )

        source = (
            "MARKET+STATIC"
        )

        confidence = (
            "NISKI"
        )

    elif static.get("ok"):

        # Za mało danych rynkowych.

        quick_sale = (
            static[
                "quick_sale"
            ]
        )

        source = (
            "STATIC"
        )

        confidence = (
            "FALLBACK"
        )

    else:

        return {
            "ok": False,
            "reason":
                static.get(
                    "reason",
                    "Brak wyceny"
                )
        }

    # ========================================================
    # KOSZTY
    # ========================================================

    service_reserve = 100

    shipping_cost = (
        50
        if mode == "POLSKA"
        else 0
    )

    total_cost = (
        purchase_price
        + service_reserve
        + shipping_cost
    )

    profit = (
        quick_sale
        - total_cost
    )

    return {
        "ok": True,

        "purchase_price":
            purchase_price,

        "quick_sale":
            round(
                quick_sale
            ),

        "profit":
            round(
                profit
            ),

        "total_cost":
            total_cost,

        "shipping_cost":
            shipping_cost,

        "service_reserve":
            service_reserve,

        "profitable":
            profit >= 400,

        "hot":
            profit >= 700,

        # informacje o źródle wyceny

        "valuation_source":
            source,

        "confidence":
            confidence,

        "market_samples":
            samples,

        "market_min":
            market.get("min"),

        "market_p25":
            market.get("p25"),

        "market_median":
            market.get("median"),

        "market_p75":
            market.get("p75"),

        # fallback

        "static_quick_sale":
            (
                static.get(
                    "quick_sale"
                )
                if static.get("ok")
                else None
            ),

        "cpu_value":
            static.get(
                "cpu_value"
            ),

        "gpu_value":
            static.get(
                "gpu_value"
            ),

        "ram_value":
            static.get(
                "ram_value"
            ),

        "disk_value":
            static.get(
                "disk_value"
            ),
    }
