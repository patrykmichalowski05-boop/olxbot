"""


def connect():

    conn = sqlite3.connect(
        WATCHLIST_DB
    )

    conn.row_factory = sqlite3.Row

    return conn


def money(value):

    if value is None:
        return "-"

    try:

        value = int(
            round(
                float(value)
            )
        )

        return (
            f"{value:,}"
            .replace(",", " ")
            + " zł"
        )

    except Exception:

        return "-"


@watchlist_bp.route(
    "/watchlist"
)
def watchlist_page():

    conn = connect()

    rows = conn.execute("""
        SELECT *
        FROM watchlist

        WHERE status != 'CLOSED'
    """).fetchall()


    counts = {
        "WATCHING": 0,
        "TRIGGERED": 0,
        "CLOSED": 0,
    }


    for status in counts:

        counts[status] = conn.execute("""
            SELECT COUNT(*)
            FROM watchlist
            WHERE status = ?
        """, (
            status,
        )).fetchone()[0]


    conn.close()


    offers = []

    gaps = []


    for row in rows:

        item = dict(
            row
        )

        price = item.get(
            "current_price"
        )

        max_buy = item.get(
            "max_buy"
        )

        gap = None


        if (
            price is not None
            and
            max_buy is not None
        ):

            gap = max(
                0,
                float(price)
                -
                float(max_buy)
            )

            if (
                item.get(
                    "status"
                )
                ==
                "WATCHING"
            ):

                gaps.append(
                    gap
                )


        item[
            "gap"
        ] = gap

        offers.append(
            item
        )


    offers.sort(
        key=lambda row: (
            0
            if row[
                "status"
            ]
            ==
            "TRIGGERED"
            else 1,

            row[
                "gap"
            ]
            if row[
                "gap"
            ]
            is not None
            else 999999,

            -(
                row[
                    "score"
                ]
                or 0
            ),
        )
    )


    closest_gap = (
        min(gaps)
        if gaps
        else None
    )


    return render_template_string(
        HTML,

        offers=offers,

        watching=counts[
            "WATCHING"
        ],

        triggered=counts[
            "TRIGGERED"
        ],

        closed=counts[
            "CLOSED"
        ],

        closest_gap=
            closest_gap,

        money=money,
    )


@watchlist_bp.post(
    "/watchlist/close/<int:item_id>"
)
def watchlist_close(
    item_id,
):

    conn = connect()

    conn.execute("""
        UPDATE watchlist

        SET status = 'CLOSED'

        WHERE id = ?
    """, (
        item_id,
    ))

    conn.commit()
    conn.close()


    return redirect(
        url_for(
            "watchlist_dashboard.watchlist_page"
        )
    )
