        margin-top: 10px;
    }
}

</style>

</head>


<body>

<div class="container">

<div class="header">

<div>

<h1>
�</h2>��� Watchlista
</h1>

<div class="label">
Oferty oczekujące na lepszą cenę
</div>

</div>

