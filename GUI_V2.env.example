# Flip Hunter Control Center V2
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME
DASHBOARD_SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_VALUE
DASHBOARD_AUTH_REQUIRED=1
DASHBOARD_COOKIE_SECURE=0
DASHBOARD_REFRESH_SECONDS=15

# Opcjonalnie. Przy standardowym wdrożeniu aplikacja sama wykrywa /opt/olx-bot.
OLX_BOT_DIR=/opt/olx-bot
