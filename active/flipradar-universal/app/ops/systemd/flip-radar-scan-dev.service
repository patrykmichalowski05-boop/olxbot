[Unit]
Description=Flip Radar DEV - skan OLX i aktualizacja strony

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/olx-bot-budget-dev/trade-radar-dev
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHON_DOTENV_DISABLED=1
Environment=OPENAI_API_KEY=sk-disabled-offline
Environment=GPU_ALERT_SEND=NO
Environment=GPU_AUTO_SEND=NO
ExecStart=/bin/bash /opt/olx-bot-budget-dev/trade-radar-dev/flip_radar_scan_once_v2_dev.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/olx-bot-budget-dev/trade-radar-dev /opt/olx-bot-ui-dev/data
TimeoutStartSec=900
