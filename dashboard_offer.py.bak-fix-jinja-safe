@offer_bp.route(
    "/offer/<int:alert_id>"
)
def offer_details(alert_id):

    conn = connect(
        ALERT_DB
    )

    alert = conn.execute("""
        SELECT *
        FROM alerts
        WHERE id = ?
    """, (
        alert_id,
    )).fetchone()

    conn.close()

    if alert is None:
        abort(404)


    details = {}
    valuation = {}
    action = {}
    snapshots = []


    try:

        conn = connect(
            SNAPSHOT_DB
        )

        rows = conn.execute("""
            SELECT *
            FROM snapshots

            WHERE offer_key = ?

            ORDER BY id DESC
        """, (
            alert[
                "offer_key"
            ],
        )).fetchall()

        conn.close()


        if rows:

            latest = rows[0]

            details = load_json(
                latest[
                    "details_json"
                ]
            )

            valuation = load_json(
                latest[
                    "valuation_json"
                ]
            )

            action = load_json(
                latest[
                    "action_json"
                ]
            )


            for row in rows:

                row_action = load_json(
                    row[
                        "action_json"
                    ]
                )

                row_valuation = load_json(
                    row[
                        "valuation_json"
                    ]
                )

                snapshots.append({
                    "created_at":
                        row[
                            "created_at"
                        ],

                    "price":
                        row[
                            "price"
                        ],

                    "score":
                        row[
                            "score"
                        ],

                    "profit":
                        row_valuation.get(
                            "profit"
                        ),

                    "action":
                        row_action.get(
                            "label"
                        )
                        or
                        row_action.get(
                            "action"
                        )
                        or
                        "-",
                })


    except Exception as e:

        print(
            "[OFFER SNAPSHOT ERROR]",
            e,
        )


    # Fallback dla starych alertów
    if not valuation:

        valuation = {
            "quick_sale":
                alert["quick_sale"],

            "profit":
                alert["profit"],
        }


    checklist = get_checklist(
        alert["offer_key"]
    )

    checklist_result = (
        calculate_adjustment(
            action.get(
                "max_buy"
            ),
            alert["price"],
            checklist,
        )
    )


    return render_template_string(
        HTML,

        alert=alert,

        details=details,

        valuation=valuation,

        action=action,

        checklist=checklist,

        checklist_result=
            checklist_result,

        adjusted_max_buy=
            checklist_result[
                "adjusted_max_buy"
            ],

        adjusted_opening=
            checklist_result[
                "adjusted_opening"
            ],

        snapshots=snapshots,

        money=money,
    )
