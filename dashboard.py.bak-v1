import sqlite3

from flask import (
    Flask,
    render_template_string,
)


app = Flask(__name__)


FAST_DB = "/opt/olx-bot/fast.db"
MARKET_DB = "/opt/olx-bot/market.db"
ALERT_DB = "/opt/olx-bot/alert_history.db"
FLIP_DB = "/opt/olx-bot/flip_results.db"


HTML = """
<!doctype html>
<html lang="pl">

<head>
    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <meta
        http-equiv="refresh"
        content="30"
    >

    <title>
        OLX Flip Hunter
    </title>

    <style>
        body {
            margin: 0;
            background: #101214;
            color: #e8e8e8;
            font-family: Arial, sans-serif;
        }

        .container {
            max-width: 1300px;
            margin: auto;
            padding: 24px;
        }

        h1 {
            margin-bottom: 4px;
        }

        .sub {
            color: #8f969e;
            margin-bottom: 28px;
        }

        .grid {
            display: grid;
            grid-template-columns:
                repeat(auto-fit, minmax(190px, 1fr));
            gap: 16px;
        }

        .card {
            background: #1a1d21;
            border: 1px solid #292d33;
            border-radius: 12px;
            padding: 18px;
        }

        .label {
            color: #9aa1a9;
            font-size: 13px;
        }

        .value {
            font-size: 28px;
            font-weight: bold;
            margin-top: 8px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            text-align: left;
            padding: 11px;
            border-bottom: 1px solid #292d33;
        }

        th {
            color: #9aa1a9;
            font-size: 13px;
        }

        a {
            color: #7cb9ff;
            text-decoration: none;
        }

        .section {
            margin-top: 30px;
        }

        .good {
            color: #70db8c;
        }

        .warn {
            color: #ffd76b;
        }

        .bad {
            color: #ff7777;
        }

        @media(max-width: 700px) {

            .container {
                padding: 12px;
            }

            table {
                font-size: 12px;
            }

            th,
            td {
                padding: 7px;
            }
        }
    </style>
</head>

<body>

<div class="container">

    <h1>
        OLX Flip Hunter
    </h1>

    <div class="sub">
        Dashboard LIVE · odświeżanie co 30 sekund
    </div>

    <div class="grid">

        <div class="card">
            <div class="label">
                Queue pending
            </div>

            <div class="value">
                {{ queue.pending }}
            </div>
        </div>

        <div class="card">
            <div class="label">
                Queue failed
            </div>

            <div class="value">
                {{ queue.failed }}
            </div>
        </div>

        <div class="card">
            <div class="label">
                Oferty market
            </div>

            <div class="value">
                {{ market.total }}
            </div>
        </div>

        <div class="card">
            <div class="label">
                Alerty
            </div>

            <div class="value">
                {{ alert_count }}
            </div>
        </div>

        <div class="card">
            <div class="label">
                Otwarte flipy
            </div>

            <div class="value">
                {{ open_count }}
            </div>
        </div>

        <div class="card">
            <div class="label">
                Sprzedane
            </div>

            <div class="value">
                {{ sold_count }}
            </div>
        </div>

        <div class="card">
            <div class="label">
                Realny zysk
            </div>

            <div class="value good">
                {{ total_profit }} zł
            </div>
        </div>

        <div class="card">
            <div class="label">
                Średni zysk / PC
            </div>

            <div class="value">
                {{ avg_profit }} zł
            </div>
        </div>

    </div>


    <div class="section">

        <h2>
            Najnowsze okazje
        </h2>

        <div class="card">

            <table>

                <tr>
                    <th>Score</th>
                    <th>Oferta</th>
                    <th>Cena</th>
                    <th>Zysk</th>
                    <th></th>
                </tr>

                {% for row in alerts %}

                <tr>
                    <td>
                        <b>
                            {{ row.score if row.score is not none else "-" }}
                        </b>
                    </td>

                    <td>
                        {{ row.title }}
                    </td>

                    <td>
                        {{ row.price or "-" }} zł
                    </td>

                    <td class="good">
                        {{ row.profit|round|int if row.profit is not none else "-" }} zł
                    </td>

                    <td>
                        {% if row.url %}

                        <a
                            href="{{ row.url }}"
                            target="_blank"
                        >
                            OLX
                        </a>

                        {% endif %}
                    </td>
                </tr>

                {% endfor %}

            </table>

        </div>

    </div>


    <div class="section">

        <h2>
            Kupione / niesprzedane
        </h2>

        <div class="card">

            <table>

                <tr>
                    <th>ID</th>
                    <th>Komputer</th>
                    <th>Kupiono</th>
                    <th>Prognoza</th>
                    <th>Koszty</th>
                </tr>

                {% for row in open_flips %}

                <tr>
                    <td>
                        {{ row.id }}
                    </td>

                    <td>
                        {{ row.title }}
                    </td>

                    <td>
                        {{ row.purchase_price|round|int }} zł
                    </td>

                    <td>
                        {{ row.predicted_quick_sale|round|int if row.predicted_quick_sale else "-" }} zł
                    </td>

                    <td>
                        {{ row.extra_cost|round|int }} zł
                    </td>
                </tr>

                {% endfor %}

            </table>

        </div>

    </div>


    <div class="section">

        <h2>
            Ostatnie sprzedaże
        </h2>

        <div class="card">

            <table>

                <tr>
                    <th>Komputer</th>
                    <th>Kupiono</th>
                    <th>Sprzedano</th>
                    <th>Zysk</th>
                </tr>

                {% for row in sold %}

                <tr>
                    <td>
                        {{ row.title }}
                    </td>

                    <td>
                        {{ row.purchase_price|round|int }} zł
                    </td>

                    <td>
                        {{ row.sale_price|round|int }} zł
                    </td>

                    <td class="good">
                        {{ row.real_profit|round|int }} zł
                    </td>
                </tr>

                {% endfor %}

            </table>

        </div>

    </div>

</div>

</body>
</html>
"""


def rows(
    database,
    query,
    params=(),
):

    try:

        conn = sqlite3.connect(
            database
        )

        conn.row_factory = sqlite3.Row

        result = conn.execute(
            query,
            params,
        ).fetchall()

        conn.close()

        return result

    except Exception:

        return []


def one(
    database,
    query,
):

    result = rows(
        database,
        query,
    )

    if result:

        return result[0]

    return None


@app.route("/")
def index():

    queue_rows = rows(
        FAST_DB,
        """
        SELECT
            status,
            COUNT(*) AS count

        FROM queue

        GROUP BY status
        """
    )

    queue = {
        "pending": 0,
        "processing": 0,
        "done": 0,
        "failed": 0,
    }

    for row in queue_rows:

        queue[
            str(
                row["status"]
            ).lower()
        ] = row["count"]


    market_row = one(
        MARKET_DB,
        """
        SELECT
            COUNT(*) AS total,
            SUM(
                CASE
                    WHEN active = 1
                    THEN 1
                    ELSE 0
                END
            ) AS active

        FROM market_offers
        """
    )

    market = {
        "total": 0,
        "active": 0,
    }

    if market_row:

        market = dict(
            market_row
        )


    alerts = rows(
        ALERT_DB,
        """
        SELECT *
        FROM alerts

        ORDER BY id DESC

        LIMIT 20
        """
    )

    alert_count_row = one(
        ALERT_DB,
        """
        SELECT
            COUNT(*) AS count

        FROM alerts
        """
    )

    alert_count = (
        alert_count_row["count"]
        if alert_count_row
        else 0
    )


    open_flips = rows(
        FLIP_DB,
        """
        SELECT *
        FROM flips

        WHERE status = 'BOUGHT'

        ORDER BY id DESC
        """
    )


    sold_rows = rows(
        FLIP_DB,
        """
        SELECT
            *,
            (
                sale_price
                -
                purchase_price
                -
                COALESCE(
                    extra_cost,
                    0
                )
            ) AS real_profit

        FROM flips

        WHERE status = 'SOLD'

        ORDER BY sold_at DESC

        LIMIT 20
        """
    )


    stats = one(
        FLIP_DB,
        """
        SELECT
            SUM(
                CASE
                    WHEN status = 'BOUGHT'
                    THEN 1
                    ELSE 0
                END
            ) AS open_count,

            SUM(
                CASE
                    WHEN status = 'SOLD'
                    THEN 1
                    ELSE 0
                END
            ) AS sold_count,

            SUM(
                CASE
                    WHEN status = 'SOLD'
                    THEN (
                        sale_price
                        -
                        purchase_price
                        -
                        COALESCE(
                            extra_cost,
                            0
                        )
                    )
                    ELSE 0
                END
            ) AS total_profit

        FROM flips
        """
    )


    open_count = 0
    sold_count = 0
    total_profit = 0

    if stats:

        open_count = (
            stats["open_count"]
            or 0
        )

        sold_count = (
            stats["sold_count"]
            or 0
        )

        total_profit = (
            stats["total_profit"]
            or 0
        )

    avg_profit = (
        total_profit
        /
        sold_count
        if sold_count
        else 0
    )


    return render_template_string(
        HTML,

        queue=queue,

        market=market,

        alerts=alerts,

        alert_count=alert_count,

        open_flips=open_flips,

        sold=sold_rows,

        open_count=open_count,

        sold_count=sold_count,

        total_profit=int(
            round(
                total_profit
            )
        ),

        avg_profit=int(
            round(
                avg_profit
            )
        ),
    )


if __name__ == "__main__":

    app.run(
        host="0.0.0.0",
        port=8088,
        debug=False,
    )
