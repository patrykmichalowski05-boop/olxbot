# ============================================================
# NORMALIZACJA
# ============================================================

def normalize_cpu(cpu):

    if not cpu:
        return None

    value = (
        str(cpu)
        .upper()
        .strip()
    )

    value = value.replace(
        "AMD ",
        ""
    )

    value = value.replace(
        "INTEL ",
        ""
    )

    value = value.replace(
        "CORE ",
        ""
    )

    value = re.sub(
        r"\s+",
        " ",
        value
    )

    # i5 10400f -> I5-10400F

    match = re.search(
        r"\bI([3579])[\s-]?(\d{4,5})(KF|F|K)?\b",
        value
    )

    if match:

        family = match.group(1)
        model = match.group(2)
        suffix = (
            match.group(3)
            or ""
        )

        return (
            f"I{family}-"
            f"{model}"
            f"{suffix}"
        )

    # Ryzen

    match = re.search(
        r"RYZEN\s+([3579])\s+"
        r"(\d{4})(X3D|X|G|GE)?",
        value
    )

    if match:

        family = match.group(1)
        model = match.group(2)
        suffix = (
            match.group(3)
            or ""
        )

        return (
            f"RYZEN {family} "
            f"{model}{suffix}"
        )

    return value


def normalize_gpu(gpu):

    if not gpu:
        return None

    value = (
        str(gpu)
        .upper()
        .strip()
    )

    value = value.replace(
        "NVIDIA ",
        ""
    )

    value = value.replace(
        "GEFORCE ",
        ""
    )

    value = value.replace(
        "RADEON ",
        ""
    )

    value = re.sub(
        r"\s+",
        " ",
        value
    )

    # RTX3060TI -> RTX 3060 TI

    match = re.search(
        r"\b(RTX|GTX)\s*"
        r"(\d{4})\s*"
        r"(TI|SUPER)?",
        value
    )

    if match:

        family = match.group(1)
        model = match.group(2)

        suffix = (
            match.group(3)
            or ""
        )

        result = (
            f"{family} {model}"
        )

        if suffix:
            result += (
                f" {suffix}"
            )

        return result

    # RX6650XT -> RX 6650 XT

    match = re.search(
        r"\bRX\s*"
        r"(\d{4})\s*"
        r"(XT|XTX)?",
        value
    )

    if match:

        model = match.group(1)

        suffix = (
            match.group(2)
            or ""
        )

        result = (
            f"RX {model}"
        )

        if suffix:
            result += (
                f" {suffix}"
            )

        return result

    return value


