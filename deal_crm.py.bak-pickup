import sqlite3
from datetime import datetime


DB_FILE = "/opt/olx-bot/deal_crm.db"
ALERT_DB = "/opt/olx-bot/alert_history.db"


VALID = {
    "NEW",
    "CONTACTED",
    "NEGOTIATING",
    "BOUGHT",
    "SOLD",
    "SKIPPED",
}


def connect():
    conn = sqlite3.connect(DB_FILE)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    conn = connect()

    conn.execute("""
        CREATE TABLE IF NOT EXISTS deals (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            offer_key TEXT NOT NULL UNIQUE,
            alert_id INTEGER,
            title TEXT,
            url TEXT,
            status TEXT NOT NULL DEFAULT 'NEW',
            created_at TEXT NOT NULL,
            updated_at TEXT NOT NULL
        )
    """)

    conn.execute("""
        CREATE INDEX IF NOT EXISTS idx_deals_status
        ON deals(status)
    """)

    conn.commit()
    conn.close()


def ensure_deal(
    offer_key,
    alert_id=None,
    title=None,
    url=None,
):
    init_db()

    now = datetime.now().isoformat(
        timespec="seconds"
    )

    conn = connect()

    conn.execute("""
        INSERT INTO deals (
            offer_key,
            alert_id,
            title,
            url,
            status,
            created_at,
            updated_at
        )

        VALUES (?, ?, ?, ?, 'NEW', ?, ?)

        ON CONFLICT(offer_key)
        DO UPDATE SET
            alert_id = COALESCE(
                excluded.alert_id,
                deals.alert_id
            ),
            title = COALESCE(
                excluded.title,
                deals.title
            ),
            url = COALESCE(
                excluded.url,
                deals.url
            ),
            updated_at = excluded.updated_at
    """, (
        offer_key,
        alert_id,
        title,
        url,
        now,
        now,
    ))

    conn.commit()
    conn.close()


def status_for_offer(
    offer_key,
):
    init_db()

    conn = connect()

    row = conn.execute("""
        SELECT status
        FROM deals
        WHERE offer_key = ?
    """, (
        offer_key,
    )).fetchone()

    conn.close()

    if not row:
        return "NEW"

    return row["status"]


def set_status(
    offer_key,
    status,
):
    init_db()

    status = str(
        status or ""
    ).upper()

    if status not in VALID:
        raise ValueError(
            "Nieprawidłowy status CRM"
        )

    conn = connect()

    conn.execute("""
        UPDATE deals

        SET
            status = ?,
            updated_at = ?

        WHERE offer_key = ?
    """, (
        status,
        datetime.now().isoformat(
            timespec="seconds"
        ),
        offer_key,
    ))

    conn.commit()
    conn.close()


def set_status_from_alert(
    alert_id,
    status,
):
    conn = sqlite3.connect(
        ALERT_DB
    )

    conn.row_factory = sqlite3.Row

    alert = conn.execute("""
        SELECT *
        FROM alerts
        WHERE id = ?
    """, (
        alert_id,
    )).fetchone()

    conn.close()

    if not alert:
        return False

    ensure_deal(
        offer_key=alert["offer_key"],
        alert_id=alert["id"],
        title=alert["title"],
        url=alert["url"],
    )

    set_status(
        alert["offer_key"],
        status,
    )

    return True
