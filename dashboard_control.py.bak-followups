# ============================================================
# DB
# ============================================================

def rows(
    database,
    query,
    params=(),
):

    try:

        conn = sqlite3.connect(
            database
        )

        conn.row_factory = sqlite3.Row

        result = conn.execute(
            query,
            params,
        ).fetchall()

        conn.close()

        return result

    except Exception as e:

        print(
            "[CONTROL DB ERROR]",
            database,
            e,
        )

        return []


def one(
    database,
    query,
    params=(),
):

    result = rows(
        database,
        query,
        params,
    )

    if result:
        return result[0]

    return None


def money(value):

    if value is None:
        return "-"

    try:

        value = int(
            round(
                float(value)
            )
        )

        return (
            f"{value:,}"
            .replace(",", " ")
            + " zł"
        )

    except Exception:

        return "-"


