# ============================================================
# ROUTE
# ============================================================

@control_bp.route(
    "/control"
)
def control():

    health = (
        collect_health()
    )

    init_crm_db()

    # ========================================================
    # CRM FUNNEL
    # ========================================================

    crm_rows = rows(
        DEAL_CRM_DB,
        """
        SELECT
            status,
            COUNT(*) AS count

        FROM deals

        GROUP BY status
        """
    )

    crm_counts = {
        "NEW": 0,
        "CONTACTED": 0,
        "NEGOTIATING": 0,
        "BOUGHT": 0,
        "SOLD": 0,
        "SKIPPED": 0,
    }

    for row in crm_rows:

        key = str(
            row["status"]
        ).upper()

        if key in crm_counts:

            crm_counts[key] = (
                row["count"]
            )


    crm_pipeline = rows(
        DEAL_CRM_DB,
        """
        SELECT
            *

        FROM deals

        WHERE status IN (
            'NEW',
            'CONTACTED',
            'NEGOTIATING'
        )

        ORDER BY
            CASE status
                WHEN 'NEGOTIATING' THEN 1
                WHEN 'CONTACTED' THEN 2
                WHEN 'NEW' THEN 3
                ELSE 4
            END,
            updated_at DESC

        LIMIT 20
        """
    )


    # ========================================================
    # FLIP STATS
    # ========================================================

    stats = one(
        FLIP_DB,
        """
        SELECT

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'SOLD'
                        THEN (
                            sale_price
                            -
                            purchase_price
                            -
                            COALESCE(
                                extra_cost,
                                0
                            )
                        )
                        ELSE 0
                    END
                ),
                0
            ) AS total_profit,

            COALESCE(
                SUM(
                    CASE
                        WHEN status = 'SOLD'
                        THEN 1
                        ELSE 0
                    END
                ),
                0
            ) AS sold_count

        FROM flips
        """
    )


    total_profit = 0
    sold_count = 0

    if stats:

        total_profit = (
            stats["total_profit"]
            or 0
        )

        sold_count = (
            stats["sold_count"]
            or 0
        )


    month_key = (
        datetime.now()
        .strftime("%Y-%m")
    )


    month = one(
        FLIP_DB,
        """
        SELECT

            COALESCE(
                SUM(
                    sale_price
                    -
                    purchase_price
                    -
                    COALESCE(
                        extra_cost,
                        0
                    )
                ),
                0
            ) AS profit

        FROM flips

        WHERE
            status = 'SOLD'
            AND sold_at LIKE ?
        """,
        (
            month_key + "%",
        ),
    )


    month_profit = (
        month["profit"]
        if month
        else 0
    ) or 0


    # ========================================================
    # INVENTORY
    # ========================================================

    inventory_rows = rows(
        FLIP_DB,
        """
        SELECT
            *,

            (
                predicted_quick_sale
                -
                purchase_price
                -
                COALESCE(
                    extra_cost,
                    0
                )
            ) AS expected_profit

        FROM flips

        WHERE status = 'BOUGHT'

        ORDER BY bought_at DESC
        """
    )


    inventory = []

    inventory_cost = 0


    for row in inventory_rows:

        item = dict(
            row
        )

        inventory_cost += (
            float(
                item.get(
                    "purchase_price"
                )
                or 0
            )
            +
            float(
                item.get(
                    "extra_cost"
                )
                or 0
            )
        )


        try:

            bought = datetime.fromisoformat(
                item[
                    "bought_at"
                ]
            )

            item[
                "days_held"
            ] = (
                datetime.now()
                -
                bought
            ).days

        except Exception:

            item[
                "days_held"
            ] = 0


        inventory.append(
            item
        )


    # ========================================================
    # ALERTS
    # ========================================================

    top_alerts = rows(
        ALERT_DB,
        """
        SELECT *

        FROM alerts

        WHERE score IS NOT NULL

        ORDER BY
            score DESC,
            profit DESC,
            id DESC

        LIMIT 10
        """
    )


    top_deal_row = one(
        ALERT_DB,
        """
        SELECT COUNT(*) AS count

        FROM alerts

        WHERE score >= 90
        """
    )


    top_deal_count = (
        top_deal_row["count"]
        if top_deal_row
        else 0
    )


    # ========================================================
    # WATCHLIST TRIGGERED
    # ========================================================

    triggered = rows(
        WATCHLIST_DB,
        """
        SELECT *

        FROM watchlist

        WHERE status = 'TRIGGERED'

        ORDER BY
            score DESC,
            triggered_at DESC

        LIMIT 10
        """
    )


    # ========================================================
    # WATCHLIST WATCHING
    # ========================================================

    watch_raw = rows(
        WATCHLIST_DB,
        """
        SELECT *

        FROM watchlist

        WHERE status = 'WATCHING'
        """
    )


    watch_candidates = []


    for row in watch_raw:

        item = dict(
            row
        )

        price = item.get(
            "current_price"
        )

        max_buy = item.get(
            "max_buy"
        )

        if (
            price is None
            or
            max_buy is None
        ):

            continue


        item[
            "gap"
        ] = max(
            0,
            float(price)
            -
            float(max_buy)
        )

        watch_candidates.append(
            item
        )


    watch_candidates.sort(
        key=lambda item: (
            item["gap"],
            -(
                item.get(
                    "score"
                )
                or 0
            ),
        )
    )


    watch_candidates = (
        watch_candidates[:10]
    )


    return render_template_string(
        HTML,

        health=health,

        money=money,

        total_profit=
            total_profit,

        month_profit=
            month_profit,

        sold_count=
            sold_count,

        inventory=
            inventory,

        inventory_count=
            len(inventory),

        inventory_cost=
            inventory_cost,

        top_alerts=
            top_alerts,

        top_deal_count=
            top_deal_count,

        triggered=
            triggered,

        watch_candidates=
            watch_candidates,

        crm_counts=
            crm_counts,

        crm_pipeline=
            crm_pipeline,
    )
